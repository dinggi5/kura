# scripts/release.env 의 본보기.
#
#   cp scripts/release.env.example scripts/release.env
#   chmod 600 scripts/release.env
#
# 실제 scripts/release.env 는 .gitignore 로 커밋에서 빠진다. 값 채우는 법은
# docs/RELEASE.md 에 단계별로 적어 뒀다.

# ── 서명 ────────────────────────────────────────────────────────────────────
# 배포용 인증서의 이름을 그대로. 확인:  security find-identity -v -p codesigning
# 반드시 'Developer ID Application' 로 시작해야 한다.
# ('Apple Development' 는 내 맥에서 돌려보는 용도라 남에게 주면 Gatekeeper 가 막는다)
# 개인 계정이라 괄호 앞은 법적 실명이 들어간다 — 그래서 이 파일은 커밋하지 않는다.
APPLE_SIGNING_IDENTITY="Developer ID Application: 이름 (팀ID)"

# ── 공증: 방법 A — App Store Connect API 키 (권장) ──────────────────────────
# 비밀번호를 어디에도 타이핑하지 않고, App Store Connect 에서 언제든 취소 가능.
APPLE_API_KEY="키_ID"                 # 예: 2X9R4HXF34
APPLE_API_ISSUER="발급자_ID"          # 예: 57246542-96fe-1a63-e053-0824d011072a
APPLE_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_키_ID.p8"

# ── 공증: 방법 B — 앱 전용 암호 ─────────────────────────────────────────────
# 방법 A 를 쓸 거면 아래 세 줄은 지우거나 그대로 주석으로 둘 것.
# 둘 다 채워져 있으면 스크립트는 A 를 쓴다.
# APPLE_ID="애플 계정 이메일"
# APPLE_PASSWORD="appleid.apple.com 에서 만든 앱 전용 암호 (계정 비밀번호 아님)"
# APPLE_TEAM_ID="팀ID"
